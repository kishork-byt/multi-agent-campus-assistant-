# Multi-Agent Campus Assistant Environment Configuration
# Copy this file to backend/.env and populate with your credentials.

MONGODB_URI=
PORT=5000

# AI Provider Configuration (Options: gemini, bedrock)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# Optional Providers
OPENAI_API_KEY=

# AWS Bedrock Configuration (when AI_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

